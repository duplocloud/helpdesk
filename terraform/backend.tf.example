# Optional: keep Terraform state in S3 instead of the local terraform.tfstate file.
# Recommended for teams and long-lived deployments (state holds generated secrets).
#
#   cp backend.tf.example backend.tf     # backend.tf is gitignored
#   terraform init -migrate-state        # moves existing local state into the bucket
#
# The bucket (and optional DynamoDB lock table) must exist before init.
terraform {
  backend "s3" {
    bucket = "my-terraform-state-bucket"
    key    = "helpdesk/terraform.tfstate"
    region = "us-east-1"

    encrypt = true
    # dynamodb_table = "my-terraform-locks"
    # profile        = "my-aws-profile"
  }
}
