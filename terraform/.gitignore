# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
errored.tfstate

# Keep lockfile committed for reproducible provider versions
!.terraform.lock.hcl

# Sensitive variable files — copy terraform.tfvars.example and fill in values
terraform.tfvars
*.auto.tfvars

# Rendered Helm values (generated at apply time)
values.yml
tfplan
tfplan.*
admin-kubeconfig
kubeconfig.yaml
*kubeconfig*

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend config (may contain bucket names / keys) — see backend.tf.example
backend.tf
backend.hcl
*.backend.hcl

# macOS
.DS_Store

# Helm provider cache (created at apply time)
.helm/
